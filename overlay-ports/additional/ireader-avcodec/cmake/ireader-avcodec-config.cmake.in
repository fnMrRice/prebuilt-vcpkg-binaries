@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@BUILD_LIBRARY_AVCODEC@ OR @BUILD_LIBRARY_AVBSF@)
    find_dependency(ireader-sdk COMPONENTS sdk)
endif()
if(@BUILD_LIBRARY_AVBSF@)
    find_dependency(ireader-media-common)
endif()
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/ireader-avcodec-targets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/ireader-avcodec-targets.cmake")
endif()
set(ireader-avcodec_AVAILABLE_COMPONENTS "@IREADER_COMPONENTS@")
foreach(component IN LISTS ireader-avcodec_FIND_COMPONENTS)
    if(component IN_LIST ireader-avcodec_AVAILABLE_COMPONENTS)
        set(ireader-avcodec_${component}_FOUND TRUE)
    else()
        set(ireader-avcodec_${component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(ireader-avcodec)
