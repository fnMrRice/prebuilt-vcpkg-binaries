include_guard(GLOBAL)
function(ireader_library name directory install_directory)
    set(sources)
    foreach(source_directory IN LISTS ARGN)
        file(GLOB_RECURSE files CONFIGURE_DEPENDS "${source_directory}/*.c" "${source_directory}/*.cpp")
        list(APPEND sources ${files})
    endforeach()
    if(NOT sources)
        message(FATAL_ERROR "No sources found for ${name}")
    endif()
    add_library(${name} STATIC ${sources})
    set_target_properties(${name} PROPERTIES POSITION_INDEPENDENT_CODE ON)
    target_include_directories(${name} PUBLIC
        "$<BUILD_INTERFACE:${directory}>"
        "$<INSTALL_INTERFACE:include>"
        "$<INSTALL_INTERFACE:include/${IREADER_INCLUDE_PREFIX}/${install_directory}>")
    if(WIN32)
        target_compile_definitions(${name} PUBLIC OS_WINDOWS)
    elseif(ANDROID)
        target_compile_definitions(${name} PUBLIC OS_ANDROID)
    elseif(APPLE)
        target_compile_definitions(${name} PUBLIC OS_MAC)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        target_compile_definitions(${name} PUBLIC OS_LINUX _GNU_SOURCE)
    endif()
    list(APPEND IREADER_EXPORT_TARGETS ${name})
    set(IREADER_EXPORT_TARGETS "${IREADER_EXPORT_TARGETS}" PARENT_SCOPE)
    install(DIRECTORY "${directory}/" DESTINATION "include/${IREADER_INCLUDE_PREFIX}/${install_directory}"
        FILES_MATCHING PATTERN "*.h" PATTERN "*.hpp" PATTERN "*.hxx")
endfunction()
