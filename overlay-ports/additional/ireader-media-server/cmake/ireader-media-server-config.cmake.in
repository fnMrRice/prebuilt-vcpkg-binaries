@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@IREADER_NEEDS_COMMON@)
    find_dependency(ireader-media-common)
endif()
if(@IREADER_NEEDS_SDK@)
    find_dependency(ireader-sdk)
endif()
if(@IREADER_NEEDS_AVCODEC@)
    find_dependency(ireader-avcodec)
endif()
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/ireader-media-server-targets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/ireader-media-server-targets.cmake")
endif()
set(ireader-media-server_AVAILABLE_COMPONENTS "@IREADER_COMPONENTS@")
foreach(component IN LISTS ireader-media-server_FIND_COMPONENTS)
    if(component IN_LIST ireader-media-server_AVAILABLE_COMPONENTS)
        set(ireader-media-server_${component}_FOUND TRUE)
    else()
        set(ireader-media-server_${component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(ireader-media-server)
