set(IREADER_NEEDS_AVCODEC TRUE)
ireader_library(rtsp "${CMAKE_CURRENT_SOURCE_DIR}/librtsp/include" rtsp "${CMAKE_CURRENT_SOURCE_DIR}/librtsp/source")
target_link_libraries(rtsp PUBLIC rtp mpeg ireader::media-server::flv mov mkv ireader::sdk::http ireader::avcodec::avbsf)
target_compile_definitions(rtsp PRIVATE RTP_OVER_RTSP_TRY_TO_FIND_NEXT_PACKET FIX_DAHUA_AAC_FROM_G711)
