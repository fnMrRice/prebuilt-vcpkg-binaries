include_guard(GLOBAL)
include(cmake/librtp.cmake)
include(cmake/libmpeg.cmake)
include(cmake/libflv.cmake)
include(cmake/libmov.cmake)
include(cmake/libmkv.cmake)
find_package(ireader-sdk CONFIG REQUIRED COMPONENTS http)
set(IREADER_NEEDS_SDK TRUE)
