@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/ireader-sdk-targets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/ireader-sdk-targets.cmake")
endif()
set(ireader-sdk_AVAILABLE_COMPONENTS "@IREADER_COMPONENTS@")
foreach(component IN LISTS ireader-sdk_FIND_COMPONENTS)
    if(component IN_LIST ireader-sdk_AVAILABLE_COMPONENTS)
        set(ireader-sdk_${component}_FOUND TRUE)
    else()
        set(ireader-sdk_${component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(ireader-sdk)
