{
  "name": "ireader-sdk",
  "version-string": "git-e84a3d1a91cacdd8dedbbc931a2886b99bec4846",
  "description": "portable system call(aio/socket/thread/process/lock/event/pipe)",
  "license": "MIT",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
